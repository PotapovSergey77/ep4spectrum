// Generated from the 48K ROM's own character generator at $3D00.
// Only the glyphs the on-screen line uses - about thirty - so the
// font costs logic rather than the last free M9K block, and the
// letters are the machine's own rather than something drawn by hand.
//
// Index is glyph*8 + row.
function [7:0] osd_font;
	input [7:0] idx;
	case (idx)
		8'd0  : osd_font = 8'h00;   // space
		8'd1  : osd_font = 8'h00;
		8'd2  : osd_font = 8'h00;
		8'd3  : osd_font = 8'h00;
		8'd4  : osd_font = 8'h00;
